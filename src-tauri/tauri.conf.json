{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyTools",
  "version": "1.1.0",
  "identifier": "com.reagancode23.mytools",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MyTools",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600,
        "backgroundColor": "#f5f7fa",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost 'self'; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "copyright": "Copyright 2026 ReaganCode23",
    "shortDescription": "Your own compact, offline toolkit",
    "longDescription": "Sign PDFs, merge and extract pages, clean image metadata, and generate strong passwords. No subscription, accounts, or file uploads.",
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMEM4RUZGOUZBNEU2MzAKUldRdzVxU2YvNDRNcW43eXVuOVJmV1J2aFJ1N3o4SVhsalpHZXZ0UjczZUFPMlI4TjRYaUZMTDkK",
      "endpoints": [
        "https://github.com/ReaganCode23/my-tools-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
